SELECT 
    m.movie_id,
    m.title AS movie_name,
    d.name AS director,
    p.name AS producer,
    l.language_name AS language,
    r.rating_score AS rating,
    m.budget,
    m.release_year,
    m.box_office_Collection,
    
    -- Hero
    MAX(CASE WHEN mc.role = 'Hero' THEN a.name END) AS hero,
    
    -- Heroine
    MAX(CASE WHEN mc.role = 'Heroine' THEN a.name END) AS heroine,
    
    -- Villain
    MAX(CASE WHEN mc.role = 'Villain' THEN a.name END) AS villain

FROM Movies m
JOIN Directors d ON m.director_id = d.director_id
JOIN Producers p ON m.producer_id = p.producer_id
JOIN Languages l ON m.language_id = l.language_id
JOIN Ratings r ON m.movie_id = r.movie_id
LEFT JOIN Movie_Cast mc ON m.movie_id = mc.movie_id
LEFT JOIN Actors a ON mc.actor_id = a.actor_id

GROUP BY m.movie_id, m.title, d.name, p.name, l.language_name, r.rating_score, m.budget, m.box_office_Collection;

